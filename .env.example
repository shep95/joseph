# joseph -> environment configuration
# copy to .env for local dev. on railway, set these as service variables.

# required: discord bot token (Discord Developer Portal -> your app -> Bot -> Token)
DISCORD_TOKEN=

# optional: a single guild id for instant slash-command sync during development.
# leave blank for global command sync (can take up to ~1h to propagate).
GUILD_ID=

# optional: enable best-effort live collection through public search interfaces.
# 0 = plan + report only (default, no network calls to search engines)
# 1 = execute the top-ranked queries via the duckduckgo html endpoint
JOSEPH_LIVE_SEARCH=0

# optional: max queries executed per investigation when live search is on
JOSEPH_MAX_LIVE_QUERIES=8

# optional: per-request http timeout in seconds for live collection
JOSEPH_HTTP_TIMEOUT=12
